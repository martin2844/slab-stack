# slab-stack-managed: slab-update-bridge-prepare.service
[Unit]
Description=Prepare the Slab update request claim directory
Documentation=https://github.com/martin2844/slab-stack
After=var-lib-slab\x2dupdate\x2dbridge-requests.mount var-lib-slab\x2dupdate\x2dbridge-status.mount
Requires=var-lib-slab\x2dupdate\x2dbridge-requests.mount var-lib-slab\x2dupdate\x2dbridge-status.mount
PartOf=var-lib-slab\x2dupdate\x2dbridge-requests.mount var-lib-slab\x2dupdate\x2dbridge-status.mount
Before=slab.service slab-update-bridge.path slab-update-bridge.service

[Service]
Type=oneshot
ExecStart=/usr/bin/install -d -o 0 -g 0 -m 0700 /var/lib/slab-update-bridge/requests/.claimed
ExecStart=/usr/bin/install -d -o 0 -g 0 -m 0700 /var/lib/slab-update-bridge/requests/.uploads
ExecStart=/usr/bin/chown 10001:0 /var/lib/slab-update-bridge/requests/.uploads
ExecStart=/usr/bin/install -d -o 0 -g 0 -m 0755 /var/lib/slab-update-bridge/status/requests
ExecStart=/bin/sh -c "umask 022; echo '{\"schemaVersion\":1,\"actions\":[\"check\",\"apply\",\"install_whatsapp\"]}' > /var/lib/slab-update-bridge/status/capabilities.json"
RemainAfterExit=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/slab-update-bridge/requests /var/lib/slab-update-bridge/status

[Install]
WantedBy=multi-user.target
