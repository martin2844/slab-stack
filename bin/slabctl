#!/bin/sh
# slab-stack-managed: slabctl
set -eu

if [ -n "${SLABCTL_TEST_ROOT:-}" ] && [ "$(id -u)" -ne 0 ]; then
  slabctl_root=$SLABCTL_TEST_ROOT
  SLABCTL_EXPECTED_OWNER_UID=$(id -u)
else
  slabctl_root=
  SLABCTL_EXPECTED_OWNER_UID=0
fi
pointer_file=$slabctl_root/etc/slab/install-directory
binary_file=$slabctl_root/usr/local/bin/slabctl
library_file=$slabctl_root/usr/local/lib/slab-stack/codex.sh
lifecycle_file=$slabctl_root/usr/local/lib/slab-stack/lifecycle.sh
domain_file=$slabctl_root/usr/local/lib/slab-stack/domain.sh
proton_file=$slabctl_root/usr/local/lib/slab-stack/proton.sh
backup_file=$slabctl_root/usr/local/lib/slab-stack/backup.sh
release_client_file=$slabctl_root/usr/local/lib/slab-stack/release-client.sh
release_public_key_file=$slabctl_root/usr/local/lib/slab-stack/release-signing-public.pem
update_file=$slabctl_root/usr/local/lib/slab-stack/update.sh
doctor_file=$slabctl_root/usr/local/lib/slab-stack/doctor.sh
manager_version_file=$slabctl_root/usr/local/lib/slab-stack/VERSION
management_transaction_file=$slabctl_root/etc/slab/management-transaction

[ "$(id -u)" -eq 0 ] || [ -n "$slabctl_root" ] || {
  echo "slabctl must run as root (use sudo)." >&2
  exit 1
}

slabctl_recover_management_transaction() {
  [ -f "$management_transaction_file" ] &&
    [ ! -L "$management_transaction_file" ] || {
      echo "slabctl: management recovery journal is unsafe" >&2
      exit 1
    }
  [ "$(stat -c '%u' "$management_transaction_file")" -eq "$SLABCTL_EXPECTED_OWNER_UID" ] &&
    [ "$(stat -c '%a' "$management_transaction_file")" = 600 ] || {
      echo "slabctl: management recovery journal has unsafe permissions" >&2
      exit 1
    }
  rollback_directory=$(sed -n '1p' "$management_transaction_file")
  case "$rollback_directory" in
    "$slabctl_root/etc/slab/".management-rollback.*) ;;
    *)
      echo "slabctl: management recovery directory is outside the trusted registry" >&2
      exit 1
      ;;
  esac
  [ -d "$rollback_directory" ] && [ ! -L "$rollback_directory" ] || {
    echo "slabctl: management recovery directory is unavailable" >&2
    exit 1
  }
  recovery_launcher=$rollback_directory/recovery-launcher
  if [ ! -f "$recovery_launcher" ]; then
    cp -p "$binary_file" "$recovery_launcher" || {
      echo "slabctl: could not preserve the recovery-aware launcher" >&2
      exit 1
    }
    chmod 0700 "$recovery_launcher"
  fi
  recovery_update=$rollback_directory/recovery-update.sh
  if [ ! -f "$recovery_update" ]; then
    cp -p "$update_file" "$recovery_update" || {
      echo "slabctl: could not preserve the recovery-aware update logic" >&2
      exit 1
    }
    chmod 0600 "$recovery_update"
  fi
  recovery_manager_version=$rollback_directory/recovery-manager-version
  if [ ! -f "$recovery_manager_version" ]; then
    cp -p "$manager_version_file" "$recovery_manager_version" || {
      echo "slabctl: could not preserve the recovery-aware manager identity" >&2
      exit 1
    }
    chmod 0600 "$recovery_manager_version"
  fi
  restore_management_target() {
    target=$1
    name=$2
    if [ -f "$rollback_directory/$name.present" ]; then
      temporary=$(dirname -- "$target")/.$(basename -- "$target").journal-restore.$$
      cp -p "$rollback_directory/$name" "$temporary" && mv "$temporary" "$target" || {
        rm -f "$temporary"
        return 1
      }
    else
      rm -f "$target" || return 1
    fi
  }
  install_recovery_wrapper() {
    previous_launcher=$rollback_directory/binary
    wrapper=$(dirname -- "$binary_file")/.slabctl.journal-wrapper.$$
    cat > "$wrapper" <<'EOF'
#!/bin/sh
# slab-stack-managed: slabctl
if [ -n "${SLABCTL_TEST_ROOT:-}" ] && [ "$(id -u)" -ne 0 ]; then
  slabctl_wrapper_root=$SLABCTL_TEST_ROOT
else
  slabctl_wrapper_root=
fi
slabctl_wrapper_transaction=$slabctl_wrapper_root/etc/slab/management-transaction
if [ -f "$slabctl_wrapper_transaction" ]; then
  slabctl_wrapper_recovery=$(sed -n '1p' "$slabctl_wrapper_transaction")/recovery-launcher
  [ -x "$slabctl_wrapper_recovery" ] || {
    echo "slabctl: management recovery launcher is unavailable" >&2
    exit 1
  }
  exec "$slabctl_wrapper_recovery" "$@"
fi
EOF
    if [ -f "$rollback_directory/binary.present" ]; then
      cat "$previous_launcher" >> "$wrapper"
    else
      cat >> "$wrapper" <<'EOF'
echo "slabctl: management installation is incomplete; rerun the installer" >&2
exit 1
EOF
    fi
    chmod 0755 "$wrapper"
    mv "$wrapper" "$binary_file"
  }
  # Restore the launcher last. If recovery itself is interrupted, the next
  # invocation must still run the recovery-aware generation.
  restore_management_target "$library_file" codex &&
    restore_management_target "$lifecycle_file" lifecycle &&
    restore_management_target "$domain_file" domain &&
    restore_management_target "$proton_file" proton &&
    restore_management_target "$backup_file" backup &&
    restore_management_target "$release_client_file" release-client &&
    restore_management_target "$release_public_key_file" release-public-key &&
    restore_management_target "$update_file" update &&
    restore_management_target "$doctor_file" doctor &&
    restore_management_target "$manager_version_file" manager-version &&
    restore_management_target "$pointer_file" pointer &&
    install_recovery_wrapper || {
      echo "slabctl: management transaction recovery failed; files remain at $rollback_directory" >&2
      exit 1
    }
  transition_state=
  if [ -f "$pointer_file" ] && [ ! -L "$pointer_file" ]; then
    transition_install_directory=$(sed -n '1p' "$pointer_file")
    transition_state_file=$transition_install_directory/config/update-state.json
    if [ -f "$transition_state_file" ] && [ ! -L "$transition_state_file" ]; then
      transition_state=$(jq -r '.status // empty' "$transition_state_file" 2>/dev/null || true)
    fi
  fi
  case "$transition_state" in
    APPLYING | RECOVERY_REQUIRED | ROLLBACK_FAILED | UPDATED | ROLLED_BACK)
      SLABCTL_TRANSITION_UPDATE_FILE=$recovery_update
      SLABCTL_TRANSITION_MANAGER_VERSION_FILE=$recovery_manager_version
      SLABCTL_TRANSITION_ROLLBACK_DIRECTORY=$rollback_directory
      ;;
    *)
      rm -f "$management_transaction_file"
      rm -rf "$rollback_directory"
      ;;
  esac
}

slabctl_complete_management_transition() {
  [ -n "${SLABCTL_TRANSITION_ROLLBACK_DIRECTORY:-}" ] || return 0
  rm -f "$management_transaction_file"
  rm -rf "$SLABCTL_TRANSITION_ROLLBACK_DIRECTORY"
  SLABCTL_TRANSITION_ROLLBACK_DIRECTORY=
}

[ ! -e "$management_transaction_file" ] || slabctl_recover_management_transaction

if [ ! -f "$pointer_file" ] || [ -L "$pointer_file" ]; then
  echo "slabctl: installation registry is missing or unsafe" >&2
  exit 1
fi
if [ ! -f "$library_file" ] || [ -L "$library_file" ]; then
  echo "slabctl: management library is missing or unsafe" >&2
  exit 1
fi
if [ ! -f "$lifecycle_file" ] || [ -L "$lifecycle_file" ]; then
  echo "slabctl: lifecycle library is missing or unsafe" >&2
  exit 1
fi
if [ ! -f "$domain_file" ] || [ -L "$domain_file" ]; then
  echo "slabctl: domain library is missing or unsafe" >&2
  exit 1
fi
if [ ! -f "$proton_file" ] || [ -L "$proton_file" ]; then
  echo "slabctl: Proton management library is missing or unsafe" >&2
  exit 1
fi
if [ ! -f "$backup_file" ] || [ -L "$backup_file" ]; then
  echo "slabctl: backup management library is missing or unsafe" >&2
  exit 1
fi
effective_update_file=${SLABCTL_TRANSITION_UPDATE_FILE:-$update_file}
effective_manager_version_file=${SLABCTL_TRANSITION_MANAGER_VERSION_FILE:-$manager_version_file}
if [ ! -f "$release_client_file" ] || [ -L "$release_client_file" ] ||
  [ ! -f "$release_public_key_file" ] || [ -L "$release_public_key_file" ] ||
  [ ! -f "$effective_update_file" ] || [ -L "$effective_update_file" ] ||
  [ ! -f "$doctor_file" ] || [ -L "$doctor_file" ] ||
  [ ! -f "$effective_manager_version_file" ] || [ -L "$effective_manager_version_file" ]
then
  echo "slabctl: release verification metadata is missing or unsafe" >&2
  exit 1
fi
for management_file in "$pointer_file" "$library_file" "$lifecycle_file" \
  "$domain_file" "$proton_file" "$backup_file" "$release_client_file" \
  "$release_public_key_file" "$effective_update_file" "$doctor_file" \
  "$effective_manager_version_file"
do
  [ "$(stat -c '%u' "$management_file")" -eq "$SLABCTL_EXPECTED_OWNER_UID" ] || {
    echo "slabctl: management metadata has an unexpected owner" >&2
    exit 1
  }
  management_mode=$(stat -c '%a' "$management_file")
  printf '%s\n' "$management_mode" | grep -Eq '([2367][0-7]|[0-7][2367])$' && {
    echo "slabctl: management metadata is group/world writable" >&2
    exit 1
  }
done
SLABCTL_MANAGER_VERSION=$(sed -n '1p' "$effective_manager_version_file")
printf '%s\n' "$SLABCTL_MANAGER_VERSION" |
  grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z][0-9A-Za-z.-]*)?$' || {
    echo "slabctl: management version is invalid" >&2
    exit 1
  }

SLABCTL_INSTALL_DIRECTORY=$(sed -n '1p' "$pointer_file")
# shellcheck source=installer/lib/codex.sh
. "$library_file"
# shellcheck source=installer/lib/lifecycle.sh
. "$lifecycle_file"
# shellcheck source=installer/lib/domain.sh
. "$domain_file"
# shellcheck source=installer/lib/proton.sh
. "$proton_file"
# shellcheck source=installer/lib/backup.sh
. "$backup_file"
# shellcheck source=installer/lib/release-client.sh
. "$release_client_file"
# shellcheck source=installer/lib/update.sh
. "$effective_update_file"
# shellcheck source=installer/lib/doctor.sh
. "$doctor_file"
slab_acquire_management_lock "$SLABCTL_INSTALL_DIRECTORY"
slabctl_load_installation "$SLABCTL_INSTALL_DIRECTORY"

slabctl_usage() {
  cat <<'EOF'
Usage:
  sudo slabctl stack start
  sudo slabctl stack stop
  sudo slabctl stack restart
  sudo slabctl stack status
  sudo slabctl domain verify
  sudo slabctl codex login [--device-auth|--api-key]
  sudo slabctl codex status
  sudo slabctl codex logout
  sudo slabctl proton setup
  sudo slabctl proton status
  sudo slabctl backup [--encrypt-with IDENTITY] [DESTINATION]
  sudo slabctl backup verify [--identity IDENTITY] ARCHIVE
  sudo slabctl restore [--dry-run] [--yes] [--identity IDENTITY] ARCHIVE
  sudo slabctl update check [--channel stable|candidate]
  sudo slabctl update apply [--channel stable|candidate] [--yes]
  sudo slabctl update rollback [--yes]
  sudo slabctl update recover-maintenance
  sudo slabctl doctor [--json]
  sudo slabctl support-bundle [--yes] [DESTINATION]

Device authorization is the default login method. API keys are accepted only
through a hidden interactive prompt or stdin and are never written by slabctl.
EOF
}

case "${1:-}" in
  stack)
    case "${2:-}" in
      start) [ "$#" -eq 2 ] || { slabctl_usage >&2; exit 2; }; slabctl_stack_start ;;
      stop) [ "$#" -eq 2 ] || { slabctl_usage >&2; exit 2; }; slabctl_stack_stop ;;
      restart) [ "$#" -eq 2 ] || { slabctl_usage >&2; exit 2; }; slabctl_stack_restart ;;
      status) [ "$#" -eq 2 ] || { slabctl_usage >&2; exit 2; }; slabctl_stack_status ;;
      *) slabctl_usage >&2; exit 2 ;;
    esac
    ;;
  domain)
    case "${2:-}" in
      verify) [ "$#" -eq 2 ] || { slabctl_usage >&2; exit 2; }; slabctl_domain_verify ;;
      *) slabctl_usage >&2; exit 2 ;;
    esac
    ;;
  codex)
    case "${2:-}" in
      login)
        case "${3:---device-auth}" in
          --device-auth) [ "$#" -eq 3 ] || [ "$#" -eq 2 ] || { slabctl_usage >&2; exit 2; }; slabctl_codex_login_device ;;
          --api-key) [ "$#" -eq 3 ] || { slabctl_usage >&2; exit 2; }; slabctl_codex_login_api_key ;;
          *) slabctl_usage >&2; exit 2 ;;
        esac
        ;;
      status) [ "$#" -eq 2 ] || { slabctl_usage >&2; exit 2; }; slabctl_codex_status ;;
      logout) [ "$#" -eq 2 ] || { slabctl_usage >&2; exit 2; }; slabctl_codex_logout ;;
      *) slabctl_usage >&2; exit 2 ;;
    esac
    ;;
  proton)
    case "${2:-}" in
      setup) [ "$#" -eq 2 ] || { slabctl_usage >&2; exit 2; }; slabctl_proton_setup ;;
      status) [ "$#" -eq 2 ] || { slabctl_usage >&2; exit 2; }; slabctl_proton_command -T --status ;;
      *) slabctl_usage >&2; exit 2 ;;
    esac
    ;;
  backup)
    case "${2:-}" in
      verify)
        shift 2
        backup_identity=
        backup_archive=
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --identity)
              [ "$#" -ge 2 ] || { slabctl_usage >&2; exit 2; }
              backup_identity=$2
              shift
              ;;
            -*) slabctl_usage >&2; exit 2 ;;
            *)
              [ -z "$backup_archive" ] || { slabctl_usage >&2; exit 2; }
              backup_archive=$1
              ;;
          esac
          shift
        done
        [ -n "$backup_archive" ] || { slabctl_usage >&2; exit 2; }
        slabctl_backup_verify "$backup_archive" "$backup_identity"
        ;;
      *)
        shift
        backup_identity=
        backup_destination=
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --encrypt-with)
              [ "$#" -ge 2 ] || { slabctl_usage >&2; exit 2; }
              backup_identity=$2
              shift
              ;;
            -*) slabctl_usage >&2; exit 2 ;;
            *)
              [ -z "$backup_destination" ] || { slabctl_usage >&2; exit 2; }
              backup_destination=$1
              ;;
          esac
          shift
        done
        slabctl_backup_create "$backup_destination" "$backup_identity"
        ;;
    esac
    ;;
  restore)
    restore_dry_run=0
    restore_confirmed=0
    restore_identity=
    restore_archive=
    shift
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --dry-run) restore_dry_run=1 ;;
        --yes) restore_confirmed=1 ;;
        --identity)
          [ "$#" -ge 2 ] || { slabctl_usage >&2; exit 2; }
          restore_identity=$2
          shift
          ;;
        -*) slabctl_usage >&2; exit 2 ;;
        *)
          [ -z "$restore_archive" ] || { slabctl_usage >&2; exit 2; }
          restore_archive=$1
          ;;
      esac
      shift
    done
    [ -n "$restore_archive" ] || { slabctl_usage >&2; exit 2; }
    slabctl_restore_archive "$restore_archive" "$restore_dry_run" \
      "$restore_confirmed" "$restore_identity"
    ;;
  update)
    update_action=${2:-check}
    shift 2 2>/dev/null || shift "$#"
    update_channel=$(jq -r '.channel' "$SLABCTL_INSTALL_DIRECTORY/release-manifest.json")
    update_confirmed=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --channel)
          [ "$#" -ge 2 ] || { slabctl_usage >&2; exit 2; }
          update_channel=$2
          shift
          ;;
        --yes) update_confirmed=1 ;;
        *) slabctl_usage >&2; exit 2 ;;
      esac
      shift
    done
    case "$update_channel" in stable | candidate) ;; *) slabctl_usage >&2; exit 2 ;; esac
    case "$update_action" in
      check) [ "$update_confirmed" -eq 0 ] || { slabctl_usage >&2; exit 2; }; slabctl_update_check "$update_channel" ;;
      apply) slabctl_update_apply "$update_channel" "$update_confirmed" ;;
      rollback) slabctl_update_rollback "$update_confirmed" ;;
      recover-maintenance)
        [ "$update_confirmed" -eq 0 ] || { slabctl_usage >&2; exit 2; }
        slabctl_update_recover_maintenance
        slabctl_complete_management_transition
        ;;
      *) slabctl_usage >&2; exit 2 ;;
    esac
    ;;
  doctor)
    case "${2:-}" in
      '') [ "$#" -eq 1 ] || { slabctl_usage >&2; exit 2; }; slabctl_doctor text ;;
      --json) [ "$#" -eq 2 ] || { slabctl_usage >&2; exit 2; }; slabctl_doctor json ;;
      *) slabctl_usage >&2; exit 2 ;;
    esac
    ;;
  support-bundle)
    shift
    support_confirmed=0
    support_destination=
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --yes) support_confirmed=1 ;;
        -*) slabctl_usage >&2; exit 2 ;;
        *)
          [ -z "$support_destination" ] || { slabctl_usage >&2; exit 2; }
          support_destination=$1
          ;;
      esac
      shift
    done
    slabctl_support_bundle "$support_destination" "$support_confirmed"
    ;;
  --help | -h) slabctl_usage ;;
  *) slabctl_usage >&2; exit 2 ;;
esac
