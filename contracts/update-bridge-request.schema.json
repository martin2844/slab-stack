{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slab.dev/contracts/update-bridge-request.schema.json",
  "title": "Slab update bridge request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "action",
    "channel",
    "target",
    "requestedAt",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "action": { "enum": ["check", "apply"] },
    "channel": { "enum": ["stable", "candidate"] },
    "target": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      ]
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "action": { "const": "apply" } },
        "required": ["action"]
      },
      "then": {
        "properties": { "target": { "type": "string" } }
      }
    }
  ]
}
