{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slab.dev/contracts/update-bridge-status.schema.json",
  "title": "Slab update bridge status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "action",
    "state",
    "channel",
    "target",
    "requestedAt",
    "startedAt",
    "completedAt",
    "result",
    "error"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "action": {
      "oneOf": [
        { "enum": ["check", "apply"] },
        { "type": "null" }
      ]
    },
    "state": { "enum": ["running", "succeeded", "failed"] },
    "channel": {
      "oneOf": [
        { "enum": ["stable", "candidate"] },
        { "type": "null" }
      ]
    },
    "target": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "requestedAt": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        { "type": "null" }
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "completedAt": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        { "type": "null" }
      ]
    },
    "result": {
      "oneOf": [
        { "type": "object" },
        { "type": "null" }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    }
  }
}
