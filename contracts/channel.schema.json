{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slab.ar/schemas/channel-v1.json",
  "title": "Slab release channel pointer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channel", "stackVersion", "manifestUrl", "manifestSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "channel": { "enum": ["stable", "candidate"] },
    "stackVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "manifestUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

