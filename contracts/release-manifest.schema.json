{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slab.ar/schemas/release-manifest-v1.json",
  "title": "Slab stack release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stackVersion",
    "channel",
    "releasedAt",
    "minimumSlabctlVersion",
    "images",
    "codexVersion",
    "migrationCompatibility"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "stackVersion": {
      "$ref": "#/$defs/semver"
    },
    "channel": {
      "enum": ["development", "stable", "candidate"]
    },
    "releasedAt": {
      "type": "string",
      "format": "date-time"
    },
    "minimumSlabctlVersion": {
      "$ref": "#/$defs/semver"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "work", "docs", "email", "runner"],
      "properties": {
        "agents": { "$ref": "#/$defs/image" },
        "work": { "$ref": "#/$defs/image" },
        "docs": { "$ref": "#/$defs/image" },
        "email": { "$ref": "#/$defs/image" },
        "runner": { "$ref": "#/$defs/image" }
      }
    },
    "codexVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "migrationCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumUpgradeStack", "minimumRollbackStack"],
      "properties": {
        "minimumUpgradeStack": { "$ref": "#/$defs/semver" },
        "minimumRollbackStack": { "$ref": "#/$defs/semver" }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "platforms"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^ghcr\\.io/[a-z0-9_.-]+/[a-z0-9_.-]+:(?:v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?|candidate-[a-f0-9]{40})$"
        },
        "digest": { "$ref": "#/$defs/digest" },
        "platforms": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["linux/amd64", "linux/arm64"]
          },
          "allOf": [
            { "contains": { "const": "linux/amd64" } },
            { "contains": { "const": "linux/arm64" } }
          ]
        }
      }
    }
  }
}
