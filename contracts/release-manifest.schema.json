{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slab.ar/schemas/release-manifest-v1.json",
  "title": "Slab stack release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stackVersion",
    "channel",
    "releasedAt",
    "minimumSlabctlVersion",
    "images",
    "codexVersion",
    "migrationCompatibility"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "stackVersion": {
      "$ref": "#/$defs/semver"
    },
    "channel": {
      "enum": ["development", "stable", "candidate", "drill"]
    },
    "releasedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "minimumSlabctlVersion": {
      "$ref": "#/$defs/semver"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents", "work", "docs", "email", "runner"],
      "properties": {
        "agents": { "$ref": "#/$defs/image" },
        "work": { "$ref": "#/$defs/image" },
        "docs": { "$ref": "#/$defs/image" },
        "email": { "$ref": "#/$defs/image" },
        "runner": { "$ref": "#/$defs/image" }
      }
    },
    "codexVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "geminiCliVersion": {
      "$ref": "#/$defs/semver"
    },
    "releaseNotesUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?::(?:[0-9]{1,4}|[0-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:[/?#](?:%[0-9A-Fa-f]{2}|[^%\\s])*)?$",
      "maxLength": 500
    },
    "severity": {
      "enum": ["routine", "security", "critical"]
    },
    "drill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedOutcome", "fault"],
      "properties": {
        "expectedOutcome": { "const": "automatic_rollback" },
        "fault": { "const": "agents_image_substituted_with_runner" }
      }
    },
    "migrationCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumUpgradeStack", "minimumRollbackStack"],
      "properties": {
        "minimumUpgradeStack": { "$ref": "#/$defs/semver" },
        "minimumRollbackStack": { "$ref": "#/$defs/semver" }
      }
    },
    "dataCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "volumes"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "volumes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agents_data", "work_data", "docs_data", "email_data"],
          "properties": {
            "agents_data": { "$ref": "#/$defs/databaseCompatibility" },
            "work_data": { "$ref": "#/$defs/databaseCompatibility" },
            "docs_data": { "$ref": "#/$defs/databaseCompatibility" },
            "email_data": { "$ref": "#/$defs/databaseCompatibility" }
          }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "platforms"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^ghcr\\.io/[a-z0-9_.-]+/[a-z0-9_.-]+:(?:v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?|candidate-[a-f0-9]{40})$"
        },
        "digest": { "$ref": "#/$defs/digest" },
        "platforms": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["linux/amd64", "linux/arm64"]
          },
          "allOf": [
            { "contains": { "const": "linux/amd64" } },
            { "contains": { "const": "linux/arm64" } }
          ]
        }
      }
    },
    "databaseCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migrations"],
      "properties": {
        "migrations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
